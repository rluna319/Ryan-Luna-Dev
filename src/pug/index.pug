                    //-     p Jan 2019 - Jun 2019

        // Research Publications Section
        section#publications.page-section
            .container
                // Research Publications Section Heading
                span.section-kicker publications
                h2.page-section-heading.text-center.text-uppercase Research Publications
                // Divider
                .divider-custom
                    .divider-custom-line
                // Publications Timeline
                .timeline(data-stagger)
                    .timeline-item.reveal
                        .timeline-card.glass-card
                            .pub-meta
                                span.pub-venue.venue-ieee IEEE
                                span.pub-date Jun 24, 2024
                            h4.pub-title Detection and Mitigation of Misleading Pheromone Trails in Foraging Robot Swarms
                            a.pub-link(href='https://ieeexplore.ieee.org/abstract/document/10597515/', target='_blank') Read the paper #[i.fas.fa-arrow-up-right-from-square]
                    .timeline-item.reveal
                        .timeline-card.glass-card
                            .pub-meta
                                span.pub-venue.venue-ieee IEEE
                                span.pub-date Apr 19, 2024
                            h4.pub-title Controlling Adversarial Pheromone-Based Infections via Quarantine Strategies in Foraging Robot Swarms
                            a.pub-link(href='https://ieeexplore.ieee.org/abstract/document/10585509/', target='_blank') Read the paper #[i.fas.fa-arrow-up-right-from-square]
                    .timeline-item.reveal
                        .timeline-card.glass-card
                            .pub-meta
                                span.pub-venue.venue-ieee IEEE
                                span.pub-date Jun 6, 2023
                            h4.pub-title Adaptive Multiple Distributed Bidirectional Spiral Path Planning for Foraging Robot Swarms
                            a.pub-link(href='https://ieeexplore.ieee.org/abstract/document/10229868', target='_blank') Read the paper #[i.fas.fa-arrow-up-right-from-square]
                    .timeline-item.reveal
                        .timeline-card.glass-card
                            .pub-meta
                                span.pub-venue.venue-ieee IEEE
                                span.pub-date Oct 19, 2021
                            h4.pub-title Reliability and Security of Extreme Parallelism
                            a.pub-link(href='https://ieeexplore.ieee.org/abstract/document/9580723', target='_blank') Read the paper #[i.fas.fa-arrow-up-right-from-square]
                    .timeline-item.reveal
                        .timeline-card.glass-card
                            .pub-meta
                                span.pub-venue.venue-springer Springer Nature
                                span.pub-date Jun 25, 2021
                            h4.pub-title Security and Reliability of Safety-Critical RTOS
                            a.pub-link(href='https://rdcu.be/cneJY', target='_blank') Read the paper #[i.fas.fa-arrow-up-right-from-square]

        // Contact Section
        section#contact.page-section
            .container
                // Contact Section Heading
                span.section-kicker contact
                h2.page-section-heading.text-center.text-uppercase Contact Me
                // Divider
                .divider-custom
                    .divider-custom-line
                // Form broken notification
                //- h4.notification.text-center.text-secondary.mb-0
                //-     | Sorry! This form is currently broken. Please reach out to me via Linkedin or Github. Thank you!


                // Contact Section Form
                .row.justify-content-center
                    .col-lg-8.col-xl-7
                        .contact-panel.glass-card.reveal
                            form#contactForm(action="https://formspree.io/f/xvgpndkb", method="POST", novalidate)
                                // Name input
                                .form-floating.mb-3
                                    input#name.form-control(
                                        type='text',
                                        name='name',
                                        placeholder='Enter your name...',
                                        required
                                        autocomplete='name'
                                    )
                                    label(for='name') Full name
                                    .invalid-feedback
                                        | A name is required.

                                // Email address input
                                .form-floating.mb-3
                                    input#email.form-control(
                                        type='email',
                                        name='email',
                                        placeholder='name@example.com',
                                        required
                                        autocomplete='email'
                                    )
                                    label(for='email') Email address
                                    .invalid-feedback
                                        | A valid email is required.

                                // Phone number input (optional)
                                .form-floating.mb-3
                                    input#phone.form-control(
                                        type='tel',
                                        name='phone',
                                        placeholder='(123) 456-7890',
                                        autocomplete='tel'
                                    )
                                    label(for='phone') Phone number (optional)

                                // Message input
                                .form-floating.mb-3
                                    textarea#message.form-control(
                                        placeholder='Enter your message here...',
                                        name='message',
                                        style='height: 10rem;',
                                        required
                                        autocomplete='off'
                                    )
                                    label(for='message') Message
                                    .invalid-feedback
                                        | A message is required.

                                // Recruiter question
                                .form-floating.mb-3
                                    .d-flex.align-items-center
                                        label.form-label.me-3(for='recruiter-yes') Are you a recruiter?
                                        .form-check.form-check-inline
                                            input.form-check-input#recruiter-yes(
                                                type='radio',
                                                name='recruiter',
                                                value='yes',
                                                required
                                            )
                                            label.form-check-label(for='recruiter-yes') Yes
                                        .form-check.form-check-inline
                                            input.form-check-input#recruiter-no(
                                                type='radio',
                                                name='recruiter',
                                                value='no',
                                                checked,
                                                required
                                            )
                                            label.form-check-label(for='recruiter-no') No
                                    // Company field, visible when 'Yes' is selected
                                    .collapse#companyField(aria-hidden='true')
                                        .form-floating.mb-3
                                            input#company.form-control(
                                                type='text',
                                                placeholder='Enter your company...',
                                                required,
                                                disabled,
                                                autocomplete='organization'
                                            )
                                            label(for='company') Company or Business Name
                                            .invalid-feedback
                                                | A company or business name is required.

                                // Hidden Subject
                                input#subject.form-control(
                                    type='hidden',
                                    name='subject',
                                    value='[Formspree] Form Submission'
                                )

                                // Submit Button
                                button#submitButton.btn.btn-primary.btn-xl(type='submit') Send

        // Footer
        footer.footer.text-center
            .container
                .row
                    // Footer Location
                    .col-lg-4.mb-5.mb-lg-0
                        h4.text-uppercase.mb-4 Location
                        p.lead.mb-0
                            | McAllen, TX, USA
                    // Footer Social Icons
                    .col-lg-4.mb-5.mb-lg-0
                        h4.text-uppercase.mb-4 Around the Web
                        a.btn.btn-outline-light.btn-social.mx-1(href='https://github.com/rluna319', aria-label="Github")
                            i.fab.fa-fw.fa-github
                        a.btn.btn-outline-light.btn-social.mx-1(href='https://www.linkedin.com/in/ryan-luna-03018180/', aria-label="LinkedIn")
                            i.fab.fa-fw.fa-linkedin-in
                    // Buy me a coffee button (custom)
                    .col-lg-4.mb-5.mb-lg-0
                        a.buy-coffee-btn(href='https://www.buymeacoffee.com/ryanluna319', target='_blank')
                            img(src='assets/bmc/bmc-full-logo-no-background.png', alt='Buy Me a Coffee Logo', class='custom-button-img')

