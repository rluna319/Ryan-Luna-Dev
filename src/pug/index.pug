doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Ryan Luna — software engineer building full-stack applications with C#, .NET, SQL Server, and Azure. Background in embedded systems and swarm robotics research.')
        meta(name='author', content='Ryan Luna')

        title Ryan Luna - Portfolio

        <link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/logo/logo2A-white_cursor.svg')

        // Font Awesome icons (free version)
        script(src='https://use.fontawesome.com/releases/v6.3.0/js/all.js', crossorigin='anonymous')

        // Google fonts
        link(href='https://fonts.googleapis.com/css?family=Montserrat:400,700', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css?family=Lato:400,700,400italic,700italic', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap', rel='stylesheet')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body#page-top

        // Scroll progress bar
        #scroll-progress

        // Cursor spotlight overlay
        #cursor-glow

        // Navigation
        nav#mainNav.navbar.navbar-expand-lg.text-uppercase.fixed-top
            .container-fluid.d-flex.justify-content-between
                // Brand aligned to the left
                a.navbar-brand.ms-lg-3(href='#page-top')
                    // My console logo
                    div#console-logo
                        img#logo-show-cursor(src='assets/logo/logo2A-white_cursor.svg', alt='Logo 2A (white)')
                        | Ryan Luna
                // Toggler for small screens
                button.navbar-toggler.text-uppercase.font-weight-bold.rounded(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                    i.fas.fa-bars
                // Navbar links - Navigation items aligned to the right
                #navbarResponsive.collapse.navbar-collapse.justify-content-end
                    ul.navbar-nav.ms-auto.me-lg-3
                        li.nav-item.mx-0.mx-lg-1
                            a.nav-link.py-3.px-0.px-lg-3.rounded(href='#about') About
                        li.nav-item.mx-0.mx-lg-1
                            a.nav-link.py-3.px-0.px-lg-3.rounded(href='#skills') Skills
                        li.nav-item.mx-0.mx-lg-1
                            a.nav-link.py-3.px-0.px-lg-3.rounded(href='#projects') Projects
                        li.nav-item.mx-0.mx-lg-1
                            a.nav-link.py-3.px-0.px-lg-3.rounded(href='#publications') Publications
                        li.nav-item.mx-0.mx-lg-1
                            a.nav-link.py-3.px-0.px-lg-3.rounded(href='#contact') Contact

        // Masthead / hero
        header.masthead
            // Particle constellation canvas
            canvas#hero-canvas
            // Drifting color glows
            .masthead-glow.glow-1
            .masthead-glow.glow-2
            .container.d-flex.align-items-center.flex-column
                // Avatar with rotating gradient ring
                .avatar-frame
                    img.masthead-avatar(src='assets/img/me/headshot_pro.jpg', alt='Ryan Luna')
                // Masthead Heading
                h1.masthead-heading.mb-0 #[img.wave(src='assets/icons/hand-wave.gif', alt='', aria-hidden='true')] I'm Ryan.
                // Typewriter line
                p.masthead-typewriter
                    span#typewriter
                    span.type-cursor(aria-hidden='true')
                // Call-to-action buttons
                .masthead-cta
                    a.btn.btn-primary.btn-lg(href='#projects') View My Work
                    a.btn.btn-glass.btn-lg(href='#contact') Get In Touch
            // Scroll cue
            a.scroll-indicator(href='#about', aria-label='Scroll down to the About section')
                i.fas.fa-chevron-down

        // About Section
        section#about.page-section
            .container
                // About Section Heading
                span.section-kicker about
                h2.page-section-heading.text-center.text-uppercase About
                // Divider
                .divider-custom
                    .divider-custom-line
                // About Section Content
                .row.align-items-center
                    .col-lg-5.me-auto.reveal
                        img.about-photo.img-fluid.mb-4(src='assets/img/me/conference-presentation-photo.jpg', alt='Ryan presenting research at a conference')
                    .col-lg-7.ms-auto.text-start.reveal
                        .about-chips
                            span.chip #[i.fas.fa-location-dot] McAllen, TX
                            span.chip #[i.fas.fa-briefcase] Software Engineer @ La Joya ISD
                            span.chip #[i.fas.fa-file-lines] 5 Research Publications
                        p.lead
                            | I'm Ryan Luna, a software engineer at La Joya ISD. I build full-stack applications, APIs, and integrations with C#, .NET, and SQL Server, hosted on Azure. Most of my work centers on database design and backend architecture — keeping systems reliable as they grow.
                        p.lead
                            | My background is in embedded systems and robotics. In undergrad, I was co-captain and payload lead for UTRGV's Rocket Launchers, where I worked on avionics and sensor systems for high-powered rockets. That hands-on work is what drew me into engineering.
                        p.lead
                            | In grad school, I started in hardware security — working with RTOS and RISC-V — then moved into swarm robotics, where my research focused on swarm security and algorithm design. I published five papers along the way. After finishing my master's, I contributed to Canonical's #[a(href='https://github.com/canonical/multipass/pull/4145', target='_blank') Multipass] project and spent a year teaching an intro to programming course in Python at UTRGV before stepping into my current role.
                        p.lead
                            | Take a look at my #[a(href='#projects') projects] and #[a(href='#publications') publications] below, and #[a(href='#contact') reach out] if you'd like to connect.

        // Skills and Technologies Section
        section#skills.page-section
            .container
                // Skills Section Heading
                span.section-kicker skills
                h2.page-section-heading.text-center.text-uppercase Skills and Technologies
                // Divider
                .divider-custom
                    .divider-custom-line
                // Skill chips — languages & backend, then tools & platforms
                .skills-cloud(data-stagger)
                    span.skill-chip.reveal #[i.skill-icon.devicon-csharp-plain.colored] #[span.skill-label C#]
                    span.skill-chip.reveal #[i.skill-icon.devicon-dotnetcore-plain.colored] #[span.skill-label .NET]
                    span.skill-chip.reveal #[i.skill-icon.devicon-microsoftsqlserver-plain.colored] #[span.skill-label SQL Server]
                    span.skill-chip.reveal #[i.skill-icon.devicon-azure-plain.colored] #[span.skill-label Azure]
                    span.skill-chip.reveal #[i.skill-icon.devicon-python-plain.colored] #[span.skill-label Python]
                    span.skill-chip.reveal #[i.skill-icon.devicon-c-plain.colored] #[span.skill-label C]
                    span.skill-chip.reveal #[i.skill-icon.devicon-cplusplus-plain.colored] #[span.skill-label C++]
                    span.skill-chip.reveal #[i.skill-icon.devicon-vscode-plain.colored] #[span.skill-label VS Code]
                    span.skill-chip.reveal #[i.skill-icon.devicon-arduino-plain.colored] #[span.skill-label Arduino]
                    span.skill-chip.reveal #[i.skill-icon.devicon-linux-plain.linux-icon] #[span.skill-label Linux]
                    span.skill-chip.reveal #[i.skill-icon.devicon-git-plain.colored] #[span.skill-label Git]
                    span.skill-chip.reveal #[i.skill-icon.devicon-github-original.gh-icon] #[span.skill-label GitHub]
                    span.skill-chip.reveal #[i.skill-icon.devicon-docker-plain.colored] #[span.skill-label Docker]
                    span.skill-chip.reveal #[i.skill-icon.devicon-html5-plain.colored] #[span.skill-label HTML5]
                    span.skill-chip.reveal #[i.skill-icon.devicon-css3-plain.colored] #[span.skill-label CSS3]

        // Projects Section
        section#projects.page-section
            .container
                // Projects Section Heading
                span.section-kicker projects
                h2.page-section-heading.text-center.text-uppercase Recent Projects
                // Divider
                .divider-custom
                    .divider-custom-line
                // Projects Grid
                .row.g-4.justify-content-center(data-stagger)
                    .col-md-6
                        .project-card.glass-card.reveal
                            .project-card-top
                                i.fab.fa-ubuntu.project-icon
                                a.project-github(href='https://github.com/canonical/multipass/pull/4145', target='_blank', aria-label='Multipass pull request on GitHub')
                                    i.fab.fa-github
                            h4.project-title Open Source Contribution — Canonical Multipass
                            p.project-dates 2025
                            .project-tags
                                span.tag C++
                                span.tag gRPC
                                span.tag CLI
                    .col-md-6
                        .project-card.glass-card.reveal
                            .project-card-top
                                i.fas.fa-rocket.project-icon
                                a.project-github(href='https://github.com/rluna319/Ryan-Luna-Dev', target='_blank', aria-label='Developer Portfolio Website on GitHub')
                                    i.fab.fa-github
                            h4.project-title Developer Portfolio Website
                            p.project-dates Aug 2024 - Present
                            .project-tags
                                span.tag Pug
                                span.tag SCSS
                                span.tag JavaScript
                    .col-md-6
                        .project-card.glass-card.reveal
                            .project-card-top
                                i.fas.fa-water.project-icon
                                a.project-github(href='https://github.com/MARSLab-UTRGV/Hydroflock', target='_blank', aria-label='Hydroflock on GitHub')
                                    i.fab.fa-github
                            h4.project-title Hydrodynamics-Based Flocking and Obstacle Avoidance for Robot Swarms
                            p.project-dates May 2024 - Aug 2024
                            .project-tags
                                span.tag Swarm Robotics
                                span.tag Flocking
                    .col-md-6
                        .project-card.glass-card.reveal
                            .project-card-top
                                i.fas.fa-shield-halved.project-icon
                                a.project-github(href='https://github.com/MARSLab-UTRGV/Foraging_Swarm_Defense', target='_blank', aria-label='Foraging Swarm Defense on GitHub')
                                    i.fab.fa-github
                            h4.project-title Detection and Mitigation of Misleading Pheromone Trails in Foraging Robot Swarms
                            p.project-dates Aug 2023 - May 2024
                            .project-tags
                                span.tag Swarm Security
                                span.tag Pheromone Trails
                    .col-md-6
                        .project-card.glass-card.reveal
                            .project-card-top
                                i.fas.fa-route.project-icon
                                a.project-github(href='https://github.com/MARSLab-UTRGV/Adaptive-Multiple-Distributed-Spiral-Search-Algorithm', target='_blank', aria-label='Adaptive Spiral Search Algorithm on GitHub')
                                    i.fab.fa-github
                            h4.project-title Adaptive Multiple Distributed Bidirectional Spiral Path Planning for Foraging Robot Swarms
                            p.project-dates Jan 2023 - Jun 2023
                            .project-tags
                                span.tag Path Planning
                                span.tag Foraging Swarms
                    .col-md-6
                        .project-card.glass-card.reveal
                            .project-card-top
                                i.fas.fa-virus-slash.project-icon
                                a.project-github(href='https://github.com/MARSLab-UTRGV/CPFA_DoS', target='_blank', aria-label='CPFA DoS on GitHub')
                                    i.fab.fa-github
                            h4.project-title Controlling Adversarial Pheromone-Based Infections via Quarantine Strategies in Foraging Robot Swarms
                            p.project-dates Aug 2022 - May 2023
                            .project-tags
                                span.tag Swarm Security
                                span.tag Quarantine Strategies
